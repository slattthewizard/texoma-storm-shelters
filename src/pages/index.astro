        <img src="/images/service-1.webp" alt="Grayson County Safe Room Rebate" width="700" height="560" style="width:100%;aspect-ratio:1.25/1;object-fit:cover;display:block;" loading="lazy">
        <span style="font-family:'Nunito Sans',sans-serif;font-size:14.5px;font-weight:800;color:#0A3D5C;padding:14px 12px;">Grayson County 50% Rebate Guide</span>
