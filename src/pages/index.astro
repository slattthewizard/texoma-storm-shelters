<!-- HERO -->
<section style="position:relative;min-height:560px;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden;">
  <img src="/images/hero-panorama.webp" alt="Texoma & North Texas landscape" width="2000" height="950" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" loading="eager" fetchpriority="high">
  <div style="position:absolute;inset:0;background:linear-gradient(180deg, rgba(10,61,92,0.55) 0%, rgba(10,61,92,0.25) 55%, rgba(10,61,92,0.45) 100%);"></div>
  <div style="position:relative;max-width:880px;padding:96px 24px 130px;">
    <span style="display:inline-block;margin-bottom:18px;padding:7px 18px;border-radius:999px;font-family:'Nunito Sans',sans-serif;font-size:12px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;background:rgba(255,255,255,0.14);color:#fff;border:1px solid rgba(255,255,255,0.35);backdrop-filter:blur(3px);">Licensed &amp; Insured · Texoma & North Texas</span>
    <h1 style="font-family:'Nunito Sans',sans-serif;font-weight:800;color:#fff;line-height:1.08;letter-spacing:-0.015em;font-size:clamp(32px,5vw,58px);margin:0 0 18px;text-shadow:0 2px 24px rgba(10,61,92,0.45);">Life-Saving Storm Shelters & Above Ground Safe Rooms for Sherman, TX</h1>
    <p style="font-size:18px;line-height:1.7;color:rgba(255,255,255,0.92);max-width:640px;margin:0 auto 30px;text-shadow:0 1px 12px rgba(10,61,92,0.5);">Texoma Storm Shelters provides certified storm shelter installation throughout Grayson, Fannin, and Cooke counties. We offer rapid response times and free on-site consultations for your peace of mind.</p>
    <div style="display:flex;justify-content:center;gap:16px;flex-wrap:wrap;">
      <a href="tel:+19038847210" class="btn-green" style="font-size:15px;padding:16px 38px;">Call Now — (903) 884-7210</a>
      <a href="/#contact" class="btn-white-outline" style="font-size:15px;">Get My Free Written Estimate</a>
    </div>
  </div>
  <svg class="swoosh" style="position:absolute;bottom:0;left:0;" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true"><path d="M0,70 C360,10 1080,10 1440,70 L1440,70 L0,70 Z" fill="#ffffff"/></svg>
</section>

<!-- INTRO -->
<section style="padding:84px 24px 64px;background:#fff;">
  <div class="intro-grid" style="max-width:1120px;margin:0 auto;display:grid;grid-template-columns:0.9fr 1.1fr;gap:64px;align-items:center;">
    <div style="position:relative;">
      <div style="border-radius:18px;overflow:hidden;box-shadow:0 24px 56px rgba(10,61,92,0.22);aspect-ratio:1/1;">
        <img src="/images/about.webp" alt="Texoma Storm Shelters service crew" width="1024" height="1024" style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy">
      </div>
      <div style="position:absolute;bottom:-18px;right:-14px;background:#2FA34D;color:#fff;border-radius:14px;padding:14px 22px;box-shadow:0 10px 26px rgba(47,163,77,0.4);">
        <p style="font-family:'Nunito Sans',sans-serif;font-size:20px;font-weight:800;margin:0;line-height:1;">24/7</p>
        <p style="font-size:11.5px;font-weight:700;margin:4px 0 0;letter-spacing:0.06em;text-transform:uppercase;">Emergency Line</p>
      </div>
    </div>
    <div>
      <span class="kicker">North Texas Storm Protection</span>
      <h2 class="section-heading" style="font-size:clamp(26px,3.4vw,40px);margin:0 0 18px;">Your Trusted Partner for Storm Shelters in Sherman and North Texas</h2>
      <div class="rich"><p>Texoma Storm Shelters provides life-saving storm protection for families and businesses throughout Sherman, Denison, and North Texas. We engineer and install FEMA-compliant above-ground safe rooms, underground bunkers, and in-garage shelters designed to withstand catastrophic EF5 tornadoes.</p><p>With North Texas facing frequent severe convective storms, our mission is to ensure every household has accessible, certified severe weather protection. Explore our <a href='/above-ground-safe-rooms/'>above-ground safe rooms</a> or review our <a href='/storm-shelter-cost/'>storm shelter cost guide</a>.</p></div>
      <a href="/about/" class="btn-blue" style="margin-top:10px;">More About Us</a>
    </div>
  </div>
</section>
<style>
  @media (max-width: 900px) { .intro-grid { grid-template-columns: 1fr !important; gap: 44px !important; } }
</style>

