      </a>
      <a href="/blog/above-ground-vs-underground-shelter/" style="display:flex;flex-direction:column;background:#fff;border-radius:16px;overflow:hidden;text-decoration:none;box-shadow:0 4px 16px rgba(10,61,92,0.1);">
        <img src="/images/service-3.webp" alt="Shelter comparison" width="700" height="560" style="width:100%;aspect-ratio:1.25/1;object-fit:cover;display:block;" loading="lazy">
