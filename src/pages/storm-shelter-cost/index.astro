          <td style="padding:13px 16px;border-bottom:1px solid #e3ded4;color:#555;">Custom dimensions with reinforced ventilation</td>
        </tr>
        <tr>
          <td style="padding:13px 16px;border-bottom:1px solid #e3ded4;color:#2B3A44;font-weight:500;">Underground Concrete Slope-Front Shelter</td>
